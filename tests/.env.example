# FortiSIEM live test credentials.
#
# Copy to .env and fill in your FortiSIEM appliance details.
# This file is gitignored -- never commit real credentials.
#
# The live tests also auto-load from:
#   ../../fsr-playbook-builder/.env.fortisiem
# if it exists and these vars aren't already set.

# Basic auth (works on all FortiSIEM versions):
FSM_HOST=fortisiem.example.com:443
FSM_USER=admin
FSM_PASS=your-password
FSM_DOMAIN=Super

# API key / OAuth2 (required for MCP tests, FortiSIEM 8.0+):
# FSM_CLIENT_ID=
# FSM_CLIENT_SECRET=

# TLS verification (set to false for self-signed lab certs):
FSM_VERIFY_SSL=false

# Mutating tests (incident comment only, benign):
# Set to true to enable incident comment tests.
FSM_ALLOW_MUTATE=false
